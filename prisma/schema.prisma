generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  PHONE
  WALK_IN
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Salon {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  custom_domain String?  @unique
  timezone      String   @default("UTC")
  created_at    DateTime @default(now())

  // back-relations
  users        User[]
  staff        Staff[]
  services     Service[]
  appointments Appointment[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
}

model User {
  id    String   @id @default(cuid())
  email String
  role  UserRole @default(CLIENT)

  // multi-tenancy anchor
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  // same email can exist across different salons; unique within a tenant
  @@unique([email, salonId])
}

model Staff {
  id   String @id @default(cuid())
  name String
  role String

  // multi-tenancy anchor
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
}

model Service {
  id               String  @id @default(cuid())
  name             String
  duration_minutes Int
  price            Decimal @db.Decimal(10, 2)

  // multi-tenancy anchor
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

model Appointment {
  id              String            @id @default(cuid())
  start_time      DateTime
  end_time        DateTime
  status          AppointmentStatus @default(PENDING)
  source          AppointmentSource
  price_charged   Decimal           @db.Decimal(10, 2)
  duration_booked Int

  // multi-tenancy anchor
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  // registered user — null for phone/walk-in bookings; use guest fields instead
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // guest booking (populated when userId is null)
  guest_name  String?
  guest_phone String?

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
}

// Each row represents one day a staff member is scheduled to work.
// @@unique enforces one entry per (staff, day) — no split-shift modelling.
model WorkingHours {
  id          String    @id @default(cuid())
  day_of_week DayOfWeek
  start_time  String // "HH:MM" 24-hour, e.g. "09:00"
  end_time    String // "HH:MM" 24-hour, e.g. "18:00"

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([staffId, day_of_week])
}

// Covers both short recurring breaks (lunch) and multi-day absences (vacation).
model TimeOff {
  id             String   @id @default(cuid())
  start_datetime DateTime
  end_datetime   DateTime

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
}
